# Filled in by `python -m bandup_proctor register`.
SWITCH_URL=http://localhost:51234
PROCTOR_AGENT_ID=
PROCTOR_API_KEY=
PROCTOR_NAME=proctor

# Optional
# PROCTOR_ROOMS=bandup-practice       # comma-separated room names; default: every room it is in
# PROCTOR_MODULE=Academic             # or General Training (picks the Task 1 bank)
# PROCTOR_TIME_SCALE=1                # 0.05 = a 40 minute task lasts 2 minutes, for demo videos
# EXAMINER_ALIAS=examiner
# SPEAKING_ALIAS=speaking
# PROCTOR_STATE=proctor-state.json
# LOG_LEVEL=INFO
